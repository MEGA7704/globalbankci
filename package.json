{
  "name": "global-bank-cloudflare",
  "version": "6.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/validate-build.mjs && node scripts/check-cloudflare-config.mjs",
    "config:check": "node scripts/check-cloudflare-config.mjs",
    "secrets:configure": "node scripts/configure-cloudflare-secrets.mjs",
    "secrets:list": "wrangler pages secret list --project-name global-bank",
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public --project-name global-bank",
    "db:migrate:remote": "wrangler d1 migrations apply bankdb --remote",
    "db:migrate:local": "wrangler d1 migrations apply bankdb --local",
    "test:security": "node tests/worker-security.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=20"
  }
}
